# osu! API v2 — create an OAuth application at https://osu.ppy.sh/home/account/edit#oauth
# Use the client credentials (client id + client secret) with the "public" scope.
OSU_CLIENT_ID=
OSU_CLIENT_SECRET=

# Discord user id (Developer Mode → right-click your profile → "Copy User ID").
# Not a secret, but keep it here rather than hardcoding it in source.
# The account must be opted into Lanyard: join https://discord.gg/lanyard
DISCORD_USER_ID=

# HenrikDev VALORANT API — get an API key at https://docs.henrikdev.xyz/
# Also supports HENRIKDEV_API_KEY or VALORANT_API_KEY.
# If unconfigured, the VALORANT card falls back gracefully to manual profile data.
HENRIK_API_KEY=HDEV-77e18900-dd6a-44d9-b953-89e6a4dcdb9f

# ---------------------------------------------------------------
# How to configure safely:
# 1. Copy this file to .env.local            (git-ignored, never commit)
# 2. Fill in real values in .env.local only
# 3. On Vercel, set the same variables in Project → Settings → Environment Variables
# Never put real secrets in this file, in source code, or in the frontend bundle.
# ---------------------------------------------------------------
